#include <stdio.h>

int main() {
    long long num;
    printf("Enter an integer number: ");
    scanf("%lld", &num);
    
    if(num < 0) num = -num;
    
    int freq[10] = {0};
    if(num == 0) freq[0] = 1;
    
    while(num > 0) {
        int digit = num % 10;
        freq[digit]++;
        num /= 10;
    }
    
    int max_freq = 0, most_frequent_digit = 0;
    for(int i = 0; i < 10; i++) {
        if(freq[i] > max_freq) {
            max_freq = freq[i];
            most_frequent_digit = i;
        }
    }
    
    printf("The digit that occurs the most times is %d (occurs %d times).\n", most_frequent_digit, max_freq);
    return 0;
}
